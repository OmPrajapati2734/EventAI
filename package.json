{
  "name": "eventai-backend",
  "version": "1.0.0",
  "description": "GenAI Celebration & Event Planner - Clean Architecture Foundational Backend",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "tsx --test tests/**/*.test.ts",
    "test:frontend": "npm --prefix frontend test",
    "lint": "tsc --noEmit",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build"
  },
  "keywords": [
    "event-planner",
    "clean-architecture",
    "genai",
    "gemini",
    "typescript",
    "zod"
  ],
  "author": "Principal Full-Stack AI Engineer",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
